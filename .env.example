# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development
# Local: sqlite:///./plantcare.db
# Cloud: PostgreSQL connection URL, e.g. Supabase pooler URL
DATABASE_URL=sqlite:///./plantcare.db
CORS_ORIGINS=http://localhost:5173
DEVICE_OFFLINE_SECONDS=180
MAX_HISTORY_ROWS=500
ALLOW_REGISTRATION=true
DEFAULT_PUMP_SECONDS=3
MAX_PUMP_SECONDS=10
WATERING_COOLDOWN_SECONDS=300
API_URL=http://127.0.0.1:8000
DEVICE_ID=
DEVICE_KEY=
INTERVAL_SECONDS=10
OFFLINE_MODE=false
